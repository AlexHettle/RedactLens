{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "os": [
    "win32"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write . ../../tooling/scripts/e2e_phase9_browser.mjs ../../tooling/scripts/e2e_phase9_browser_errors.mjs ../../tooling/scripts/e2e_phase9_browser_errors.test.mjs",
    "format:check": "prettier --check . ../../tooling/scripts/e2e_phase9_browser.mjs ../../tooling/scripts/e2e_phase9_browser_errors.mjs ../../tooling/scripts/e2e_phase9_browser_errors.test.mjs",
    "test": "vitest run",
    "test:a11y:e2e": "npm run build && playwright test",
    "test:a11y:e2e:headed": "npm run build && playwright test --headed",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
